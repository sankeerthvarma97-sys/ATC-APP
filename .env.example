# PostgreSQL is the production database target.
# Example local URL:
# DATABASE_URL="postgresql://aocc:aocc@localhost:5432/aocc?schema=public"
DATABASE_URL=""
AOCC_USE_DATABASE="false"

# Auth.js / NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# AI: use either Vercel AI Gateway or direct Gemini.
# The app falls back to a deterministic simulated briefing if no key is present.
AI_GATEWAY_API_KEY=""
AOCC_AI_MODEL="google/gemini-3.8-flash"
GOOGLE_GENERATIVE_AI_API_KEY=""
AOCC_GOOGLE_MODEL="gemini-3.8-flash"
GEMINI_PROJECT_ID=""

# Public map tile token. This is safe to expose to the browser when scoped in Mapbox.
NEXT_PUBLIC_MAPBOX_TOKEN=""

# S3-compatible object storage for artifacts, reports, and exported simulation data.
AWS_ENDPOINT_URL_S3=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-2"
S3_BUCKET=""

# Resend notification email integration.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Real-time simulation
PORT=3000
AOCC_SIMULATION_TICK_MS=2500
